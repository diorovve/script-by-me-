-- ============ Input (Menu + Lock) ============
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    -- menu toggle
    if input.KeyCode == Enum.KeyCode.Q then
        Config.MenuOpen = not Config.MenuOpen
        if MainFrame then MainFrame.Visible = Config.MenuOpen end
        return
    end
    
    -- lock input
    local bind = Config.LockBind
    local matched = (input.KeyCode == bind) or (input.UserInputType == bind)
    if matched then
        if Config.LockMode == "Press" then
            Config.LockActive = not Config.LockActive
        else
            Config.LockActive = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    local bind = Config.LockBind
    local matched = (input.KeyCode == bind) or (input.UserInputType == bind)
    if matched and Config.LockMode == "Hold" then
        Config.LockActive = false
    end
end)

-- ============ Lock Camera ============
RunService.RenderStepped:Connect(function()
    if not Config.LockActive then return end
    if #Config.LockedPlayers == 0 then return end

    local sum = Vector3.new(0, 0, 0)
    local count = 0

    for i = #Config.LockedPlayers, 1, -1 do
        local p = Config.LockedPlayers[i]
        if not IsAlive(p) then
            -- если труп — пропускаем, но не удаляем из списка сразу
            -- (чтобы лок вернулся когда он респавнится)
            continue
        end
        local head = p.Character:FindFirstChild("Head")
        if head then
            sum = sum + head.Position
            count = count + 1
        end
    end

    if count > 0 then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, sum / count)
    end
end)


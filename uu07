table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then
        Config.MenuOpen = not Config.MenuOpen
        if MainFrame then MainFrame.Visible = Config.MenuOpen end
        return
    end
    local bind = Config.LockBind
    local matched = (input.KeyCode == bind) or (input.UserInputType == bind)
    if matched then
        if Config.LockMode == "Press" then
            Config.LockActive = not Config.LockActive
        else
            Config.LockActive = true
        end
    end
end))

table.insert(Connections, UserInputService.InputEnded:Connect(function(input, gp)
    local bind = Config.LockBind
    local matched = (input.KeyCode == bind) or (input.UserInputType == bind)
    if matched and Config.LockMode == "Hold" then
        Config.LockActive = false
    end
end))

local LockConnection = RunService.RenderStepped:Connect(function()
    if not Config.LockActive then return end
    if #Config.LockedPlayers == 0 then return end

    local bestTargetPos = nil
    local shortestDist = math.huge
    
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for i = #Config.LockedPlayers, 1, -1 do
        local p = Config.LockedPlayers[i]
        if not p or not p.Parent or not p.Character then
            table.remove(Config.LockedPlayers, i)
            continue
        end
        
        if not IsAlive(p) then continue end
        
        local head = p.Character:FindFirstChild("Head")
        if head then
            if myHRP then
                local dist = (head.Position - myHRP.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestTargetPos = head.Position
                end
            else
                bestTargetPos = head.Position
                break
            end
        end
    end

    if bestTargetPos then
        local currentCFrame = Camera.CFrame
        local targetCFrame = CFrame.new(currentCFrame.Position, bestTargetPos)
        Camera.CFrame = currentCFrame:Lerp(targetCFrame, 0.5)
    end
end)


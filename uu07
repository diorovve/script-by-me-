local function InList(list, p)
    for _, x in ipairs(list) do if x == p then return true end end
    return false
end

local function ToggleList(list, p)
    for i, x in ipairs(list) do
        if x == p then table.remove(list, i) return true end
    end
    table.insert(list, p)
    return false
end

local function IsAlive(p)
    if not p or not p.Parent or not p.Character then return false end
    local hum = p.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    return true
end

local function ApplyESPTo(p)
    if not p.Character then return end
    local shouldHave = Config.ESP and InList(Config.ESPTargets, p)
    local hl = p.Character:FindFirstChild("ShivESP")
    if shouldHave and not hl then
        local h = Instance.new("Highlight")
        h.Name = "ShivESP"
        h.FillColor = Color3.fromRGB(255, 0, 0)
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.Parent = p.Character
    elseif not shouldHave and hl then
        hl:Destroy()
    end
end

local function RefreshAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then ApplyESPTo(p) end
    end
end

